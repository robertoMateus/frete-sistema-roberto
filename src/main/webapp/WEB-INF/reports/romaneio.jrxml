    <!-- ═══════════════════════════════════════════════════════
         PARÂMETROS
         ═══════════════════════════════════════════════════════ -->
    <parameter name="ID_MOTORISTA"    class="java.lang.Long"   isForPrompting="false"/>
    <parameter name="DATA_ROMANEIO"   class="java.sql.Date"    isForPrompting="false"/>
    <parameter name="DATA_GERACAO"    class="java.lang.String" isForPrompting="false"/>

    <parameter name="NOME_MOTORISTA"  class="java.lang.String" isForPrompting="false"/>
    <parameter name="CPF_MOTORISTA"   class="java.lang.String" isForPrompting="false"/>
    <parameter name="CNH_MOTORISTA"   class="java.lang.String" isForPrompting="false"/>
    <parameter name="PLACA_VEICULO"   class="java.lang.String" isForPrompting="false"/>
    <parameter name="TIPO_VEICULO"    class="java.lang.String" isForPrompting="false"/>

    <queryString language="SQL">
        <![CDATA[
        SELECT
            f.numero,
            rem.razao_social                            AS remetente,
            dest.razao_social                           AS destinatario,
            f.municipio_origem  || ' - ' || f.uf_origem AS origem,
            f.municipio_destino || ' - ' || f.uf_destino AS destino,
            f.descricao_carga,
            f.peso_kg,
            f.volumes,
            f.valor_total,
            f.status,
            f.data_previsao_entrega
        FROM frete f
        JOIN cliente rem  ON rem.id  = f.id_remetente
        JOIN cliente dest ON dest.id = f.id_destinatario
        WHERE f.id_motorista = $P{ID_MOTORISTA}
          AND f.status NOT IN ('CANCELADO')
          AND DATE(f.data_emissao) = $P{DATA_ROMANEIO}
        ORDER BY f.numero ASC
        ]]>
    </queryString>

    <field name="numero"               class="java.lang.String"/>
    <field name="remetente"            class="java.lang.String"/>
    <field name="destinatario"         class="java.lang.String"/>
    <field name="origem"               class="java.lang.String"/>
    <field name="destino"              class="java.lang.String"/>
    <field name="descricao_carga"      class="java.lang.String"/>
    <field name="peso_kg"              class="java.math.BigDecimal"/>
    <field name="volumes"              class="java.lang.Integer"/>
    <field name="valor_total"          class="java.math.BigDecimal"/>
    <field name="status"               class="java.lang.String"/>
    <field name="data_previsao_entrega" class="java.sql.Timestamp"/>

    <variable name="TOTAL_FRETES"      class="java.lang.Integer"        calculation="Count">
        <variableExpression><![CDATA[$F{numero}]]></variableExpression>
    </variable>
    <variable name="TOTAL_PESO"        class="java.math.BigDecimal"     calculation="Sum">
        <variableExpression><![CDATA[$F{peso_kg}]]></variableExpression>
    </variable>
    <variable name="TOTAL_VOLUMES"     class="java.lang.Integer"        calculation="Sum">
        <variableExpression><![CDATA[$F{volumes}]]></variableExpression>
    </variable>
    <variable name="TOTAL_VALOR"       class="java.math.BigDecimal"     calculation="Sum">
        <variableExpression><![CDATA[$F{valor_total}]]></variableExpression>
    </variable>

