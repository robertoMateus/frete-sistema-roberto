	<parameter name="REPORT_TITLE" class="java.lang.String" isForPrompting="false" />
	<parameter name="DATA_GERACAO" class="java.lang.String" isForPrompting="false" />
	<queryString language="SQL">
		<![CDATA[SELECT
            f.numero,
            rem.razao_social                                    AS remetente,
            dest.razao_social                                   AS destinatario,
            m.nome                                              AS motorista,
            f.municipio_destino,
            f.uf_destino,
            f.data_previsao_entrega                             AS data_previsao,
            f.status,
            GREATEST(0, (CURRENT_DATE - f.data_previsao_entrega::date)::int) AS dias_atraso
        FROM frete f
        JOIN cliente  rem  ON rem.id  = f.id_remetente
        JOIN cliente  dest ON dest.id = f.id_destinatario
        JOIN motorista m   ON m.id    = f.id_motorista
        WHERE f.status NOT IN ('ENTREGUE', 'NAO_ENTREGUE', 'CANCELADO')
        ORDER BY f.data_previsao_entrega ASC, f.numero ASC]]>
	</queryString>
	<field name="numero" class="java.lang.String" />
	<field name="remetente" class="java.lang.String" />
	<field name="destinatario" class="java.lang.String" />
	<field name="motorista" class="java.lang.String" />
	<field name="municipio_destino" class="java.lang.String" />
	<field name="uf_destino" class="java.lang.String" />
	<field name="data_previsao" class="java.sql.Timestamp" />
	<field name="status" class="java.lang.String" />
	<field name="dias_atraso" class="java.lang.Integer" />
	<variable name="TOTAL_FRETES" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{numero}]]></variableExpression>
	</variable>
	<variable name="TOTAL_ATRASADOS" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{dias_atraso} != null && $F{dias_atraso} > 0 ? 1 : 0]]></variableExpression>
	</variable>
